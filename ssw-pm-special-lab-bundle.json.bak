    {
      "id": "lab-haccp-001",
      "questionNumber": 1,
      "sourcePdf": "HACCP_SSW_quiz.html",
      "sourcePage": 1,
      "pdfPage": 1,
      "setId": "ssw-pm-lab-haccp",
      "setName": "HACCP・衛生管理 (HACCP Principles)",
      "points": 3.75,
      "questionImage": "",
      "questionText": "HACCP（ハサップ）による衛生管理の基本的な考え方について、正しいものを一つ選びなさい。",
      "questionTextStatus": "verified",
      "correctAnswer": "D",
      "correctIndex": 3,
      "prompt": "HACCP（ハサップ）による衛生管理の基本的な考え方について、正しいものを一つ選びなさい。",
      "instructions": "正しいものを一つ選びなさい。",
      "explanation": "【正解：D】\nHACCPは一般衛生管理を前提条件（土台）とし、原材料から出荷までの工程で発生しうる危害要因（ハザード）を科学的に分析（原則1）し、特に重要な工程（重要管理点: CCP）を定めて継続的に監視・記録する衛生管理手法です。重要管理点が複数存在する場合もあります。",
      "imageMediaId": "",
      "imageSize": "large",
      "imageRatio": "auto",
      "imagePosition": "center",
      "active": true,
      "createdAt": 1762520000001,
      "updatedAt": 1762520000001,
      "options": [
        {
          "id": "A",
          "text": "一般衛生管理はすべて不要になり、重要管理点（CCP）の1箇所だけを管理すればよい。",
          "translation": "Semua sanitasi umum menjadi tidak diperlukan, cukup mengelola 1 titik kendali kritis (CCP) saja."
        },
        {
          "id": "B",
          "text": "製造する食品の種類に関わらず、重要管理点は必ず1工場につき1つだけに限定される。",
          "translation": "Tanpa memandang jenis pangan, CCP wajib dibatasi hanya 1 titik saja per pabrik."
        },
        {
          "id": "C",
          "text": "決められた管理基準が正しく守られなくても、記録さえ書けば食品を出荷できる。",
          "translation": "Meski batas kritis tidak ditaati, produk pangan tetap boleh dikirim asalkan catatan ditulis."
        },
        {
          "id": "D",
          "text": "食品の危害要因を分析し、必要な管理方法（重要管理点）を決めて実行状況を連続的に監視する。",
          "translation": "Menganalisis bahaya pada pangan, menentukan pengendalian yang diperlukan (CCP), dan memantau pelaksanaannya secara kontinu."
        }
      ],
      "media": [],
      "promptTranslation": "Mengenai prinsip dasar manajemen sanitasi berbasis HACCP, pilihlah satu pernyataan yang benar."
    },
